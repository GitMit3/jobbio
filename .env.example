# Kopiera till .env och fyll i värdena.
# .env läses av Vite i utveckling och ska ALDRIG committas.

# --- Anthropic (server-side, exponeras aldrig i webbläsaren) ---
# Hämtas på https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Valfritt: byt modell eller sänk/höj hur mycket modellen får "tänka".
# Giltiga effort-nivåer: low | medium | high | xhigh | max
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium

# --- Claude Code-läget (bara lokalt) ---
# Kör analyserna via din lokala Claude Code och ditt abonnemang i stället för
# API-krediter. Kräver ingen konfiguration - flaggorna nedan är valfria.
# JOBBIO_LOCAL_MODEL=opus
# JOBBIO_LOCAL_EFFORT=medium
# JOBBIO_LOCAL_TIMEOUT_MS=300000

# --- Supabase (se README) ---
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=ey...
